{
  "name": "true-mobsters",
  "version": "1.0.0",
  "description": "True Mobsters — VisionIt Studio multiplayer mafia game",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "seed": "npm run seed --prefix server",
    "generate-thumbnails": "npm run generate-thumbnails --prefix server",
    "generate-ai-art": "npm run generate-ai-art --prefix server",
    "generate-ui-art": "npm run generate-ui-art --prefix server",
    "purge-legacy-svg": "npm run purge-legacy-svg --prefix server",
    "svg-to-webp": "npm run svg-to-webp --prefix server",
    "regenerate-thumbnails": "npm run regenerate-thumbnails --prefix server",
    "optimize-thumbnails": "npm run optimize-thumbnails --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
