{
  "name": "true-mobsters-server",
  "version": "1.0.0",
  "description": "True Mobsters server — VisionIt Studio",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "NODE_ENV=production node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/db/seed.js",
    "generate-thumbnails": "node scripts/generate-thumbnails.js",
    "generate-ai-art": "node scripts/generate-ai-thumbnails.js",
    "generate-ui-art": "node scripts/generate-ui-thumbnails.js",
    "purge-legacy-svg": "node scripts/purge-legacy-svg-art.js",
    "svg-to-webp": "node scripts/svg-to-webp.js",
    "regenerate-thumbnails": "node scripts/purge-legacy-svg-art.js && node scripts/generate-ai-thumbnails.js",
    "optimize-thumbnails": "node scripts/optimize-thumbnails.js",
    "optimize-webp": "node scripts/optimize-existing-webp.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
